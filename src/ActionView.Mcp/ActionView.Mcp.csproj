<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ActionView.Core\ActionView.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <IsPackable>true</IsPackable>
    <ToolCommandName>actionview-mcp</ToolCommandName>
    <PackageId>ActionView.Mcp</PackageId>
    <Description>MCP server for ActionView - exposes the review queue to AI agents via the Model Context Protocol</Description>
    <Authors>ActionView</Authors>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\schemas\entry.v1.schema.json" LogicalName="entry.v1.schema.json" />
  </ItemGroup>

</Project>
